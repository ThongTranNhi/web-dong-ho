# Mẫu cấu hình cho Luxury Watches. Chép thành .env (cùng thư mục) rồi điền giá trị thật.
# .env bị Git và Docker build bỏ qua: không bao giờ commit mật khẩu hay API key.
# Danh sách đầy đủ và giải thích: docs/DOCKER_DEPLOY.md

# ---------------------------------------------------------------------------
# Docker Compose (local)
# ---------------------------------------------------------------------------
APP_PORT=8000
# Cổng phpMyAdmin (chỉ khi chạy: docker compose --profile tools up -d)
PMA_PORT=8081

# Database cho WordPress (phải khớp với MYSQL_* bên dưới)
WORDPRESS_DB_HOST=db
WORDPRESS_DB_NAME=luxury_watches
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=change_me

# Khởi tạo MySQL (chỉ có tác dụng ở lần chạy đầu, khi volume database còn trống)
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=luxury_watches
MYSQL_USER=wordpress
MYSQL_PASSWORD=change_me

# ---------------------------------------------------------------------------
# WordPress
# ---------------------------------------------------------------------------
WP_HOME=http://localhost:8000
WP_SITEURL=http://localhost:8000
# local | development | staging | production
WP_ENVIRONMENT_TYPE=local
WORDPRESS_DEBUG=false

# Khóa bảo mật – nên đặt, mỗi giá trị là chuỗi ngẫu nhiên dài.
# Tạo nhanh: https://api.wordpress.org/secret-key/1.1/salt/
# Để trống thì khóa được dẫn xuất từ thông tin database (vẫn ổn định giữa các lần chạy).
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# ---------------------------------------------------------------------------
# Tích hợp
# ---------------------------------------------------------------------------
# Gemini API key cho chatbot (Google AI Studio). Dùng một trong hai tên.
LUXURY_CHATBOX_GEMINI_KEY=
GEMINI_API_KEY=

# Google OAuth Client ID cho nút "Đăng nhập bằng Google" (Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID → Web application).
# Authorized JavaScript origins: http://localhost:8000 (và domain thật khi deploy).
# Để trống thì nút Google không hiển thị.
GOOGLE_CLIENT_ID=

# Origin được gọi API luxury/v1 từ trình duyệt (CORS), phân tách bằng dấu phẩy.
LW_API_ALLOWED_ORIGINS=

# SePay: tài khoản ngân hàng, API key và webhook cấu hình trong
# WooCommerce → Cài đặt → Thanh toán → SePay (lưu trong database, không đặt ở đây).
